# Copy to .env for local runs. In GitHub, these go in
# Settings > Secrets and variables > Actions.

# ── Required for the digest to be a digest ────────────────────────────────────
# Without this you get an unranked feed: no scores, no summaries.
ANTHROPIC_API_KEY=

# ── Required to receive the email ─────────────────────────────────────────────
RESEND_API_KEY=
DIGEST_TO_EMAILS=hkonsker@stanford.edu
# Until you verify a domain in Resend, leave this unset. The default test
# sender only delivers to the address that owns the Resend account.
# DIGEST_FROM_EMAIL=digest@yourdomain.com

# ── Optional ──────────────────────────────────────────────────────────────────
# Strongly recommended, and effectively required in CI. Without it the 3 req/s
# PubMed limit is shared across everyone on your IP, and GitHub's runners have
# busy shared IPs. Free: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Public URL of the archive, linked at the bottom of each email.
# DIGEST_SITE_URL=https://<your-github-username>.github.io/womens-health-ai-digest/

# Ranking model and effort. Defaults: claude-opus-5 at medium effort.
# DIGEST_MODEL=claude-opus-5
# DIGEST_EFFORT=medium
